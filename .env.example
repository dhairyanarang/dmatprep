# dMAT Prep — environment
#
# Every one of these is optional. With none of them set the app runs exactly as
# it always has: fully usable as a guest, with progress in localStorage and no
# sign-in affordance rendered anywhere. Set them to turn on optional accounts.
#
# Copy to `.env.local` and fill in from your Supabase project's API settings.
# `.env.local` is gitignored. Never commit real values.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (formerly "anon"). Safe in the browser by design: row
# level security, not key secrecy, is what keeps one candidate's attempts away
# from another's.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The service-role key is NEVER used by this app. It bypasses row level
# security, so it must not be added here or to any Vercel environment for this
# project. If you find yourself wanting it, the query belongs somewhere else.
