# dMAT Prep — environment.
#
# NAMES ONLY. Never commit a value for any secret in this file, and never paste
# one into source, a document or a chat. Real values belong in `.env.local`,
# which is git-ignored, or in the hosting provider's environment settings.
#
# The app builds and runs with every variable below unset: guest mode is a
# supported mode, every page is static, progress lives in localStorage, and no
# sign-in affordance is rendered. See docs/SUPABASE.md.

# --- Accounts and cloud sync (optional) ------------------------------------
# Both are publishable by design: row level security, not key secrecy, is what
# keeps one candidate's attempts away from another's.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Payments (optional; required only to sell) ----------------------------
# Turns the commercial surface on. Unset, the product behaves exactly as it
# always has: all Core questions free, every solution in public/solutions, no
# purchase flow anywhere. Setting it to 1 also makes the build move premium
# solutions out of public/ and behind an entitlement check.
NEXT_PUBLIC_COMMERCE_ENABLED=

# SERVER-ONLY. Bypasses row level security, so it must never be prefixed
# NEXT_PUBLIC_ and must never reach a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay. Test-mode keys need only a sign-up — no KYC, no activation, no
# website. Live keys additionally require account activation and the six policy
# pages. See docs/RAZORPAY.md §5 and §12.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A secret YOU choose in the Razorpay dashboard. It must differ from
# RAZORPAY_KEY_SECRET, and it is not optional here: without it there is no
# webhook signature to verify and the endpoint would grant on anyone's word.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret for the reconciliation endpoint, which a scheduler calls and so
# has no session. Any long random string.
RECONCILE_SECRET=

# Local development only. Set to `mock` to run the purchase flow against an
# in-memory provider that signs with the same two schemes as Razorpay. Refused
# in production builds.
PAYMENTS_PROVIDER=
