# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds placeholders only and is how another
# developer learns which variables exist.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Official g.a.s.t. / APS source material. Copyrighted, and this repo is public —
# fetch it locally with scripts/extract-pdf.mjs instead of committing it.
/source-material/
*.pdf

# local review artifacts
/.playwright-mcp/
/*.png

# Supabase CLI link state. Holds the project ref and pooler URL for this
# machine — local scaffolding, not part of the project.
supabase/.temp/
