# dMAT Prep — PILOT (test) environment.
#
# Copy to `.env.pilot` and fill in. NEVER commit `.env.pilot`, never paste its
# values into a chat, an issue or a commit message.
#
#   cp .env.pilot.example .env.pilot
#   npm run dev:pilot
#
# `npm run dev:pilot` reads `.env.pilot` ONLY. It refuses to start unless every
# variable below has a value, which is what stops a forgotten line silently
# falling through to the production values in `.env.local` — Next.js resolves
# `process.env` first and `.env.local` only afterwards, so a gap, not an
# override, is the thing that would bite.
#
# `.env.local` is never read, written or modified by the pilot command.

# ---------------------------------------------------------------------------
# Supabase — the PILOT project (dmatprep-pilot). NOT production.
# ---------------------------------------------------------------------------

# Dashboard → Project Settings → Data API → Project URL.
# Looks like https://<ref>.supabase.co — the <ref> is the 20-character project
# reference, not the project name.
NEXT_PUBLIC_SUPABASE_URL=

# The same <ref>, on its own. The launcher and the payment layer both compare
# this against the ref inside the URL above and refuse to run on a mismatch,
# and the launcher additionally refuses if it matches the ref in `.env.local`.
# Two fields saying the same thing is the point: a typo in one is caught.
SUPABASE_PROJECT_REF_EXPECTED=

# Dashboard → Project Settings → API Keys.
# PUBLISHABLE (sb_publishable_…) if the project has one, otherwise the legacy
# anon key. Safe in the browser by design: row level security, not key secrecy,
# is what separates one candidate's data from another's.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. SECRET (sb_secret_…) if the project has one, otherwise the
# legacy service_role key. It BYPASSES row level security.
# Never prefix it NEXT_PUBLIC_, never commit it, and do not set it in
# production — without it the payment routes answer 503, which is the
# structural guarantee that production cannot write a payment row.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Razorpay — TEST MODE ONLY.
#
# Test keys need only a sign-up: no KYC, no activation, no website. A live key
# (rzp_live_…) must never appear here; a test key starts rzp_test_.
# ---------------------------------------------------------------------------

# Dashboard → Test Mode → Account & Settings → API Keys → Generate Test Key.
RAZORPAY_KEY_ID=

# Shown ONCE when the test key is generated. Signs the Checkout return, over
# `order_id|payment_id`.
RAZORPAY_KEY_SECRET=

# A string YOU choose when creating the webhook, in Test Mode.
# It signs the webhook body and MUST differ from RAZORPAY_KEY_SECRET — they are
# two different schemes over two different messages, and reusing one value for
# both hides a whole class of mistake.
# Razorpay calls this optional. It is not optional here: with no secret there is
# no signature to verify, and the endpoint would grant on anyone's word.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Pilot behaviour
# ---------------------------------------------------------------------------

# Turns the commercial surface on LOCALLY: the purchase flow renders, and the
# build moves premium solutions out of public/ behind an entitlement check.
# Set to 1 for the pilot. It must stay unset in production.
NEXT_PUBLIC_COMMERCE_ENABLED=1

# Read by `scripts/build-solutions.mjs` at build time, for the same split.
COMMERCE_ENABLED=1

# Any long random string you invent. Guards the reconciliation endpoint, which
# a scheduler calls and so has no session. Used to test recovery by hand:
#   curl -X POST localhost:3000/api/reconcile -H "x-reconcile-secret: <this>"
RECONCILE_SECRET=

# Leave BLANK to use the real Razorpay Test Mode adapter, which is the point of
# the pilot. Set to `mock` only to exercise the flow with no provider at all.
# Refused outright in production builds.
PAYMENTS_PROVIDER=
